---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FeatureList from '~/components/FeatureList.astro';
import Ability from '~/components/Ability.astro';
import { renderMarkdown } from '~/lib/markdown';
import { all, entrySlug } from '~/lib/data';
import { href, abilityCostAnchor } from '~/lib/url';

export function getStaticPaths() {
	return all('classes').map(entry => ({ params: { slug: entrySlug(entry) }, props: { entry } }));
}

const { entry: c } = Astro.props;
const primaryOptions: string[][] = c.primaryCharacteristicsOptions ?? [];
const primary = primaryOptions.map(o => o.join(' + ')).join('  /  ');
const fbl = c.featuresByLevel ?? [];
const abilities = c.abilities ?? [];
const subclasses = c.subclasses ?? [];
const subTypeLabel = c.subclassName || 'Subclass';
// Subclass features granted at a given level (interleaved into the main progression).
const subFeaturesAt = (s: any, level: number): any[] => (s.featuresByLevel ?? []).find((l: any) => l.level === level)?.features ?? [];
// Group abilities by cost (signature first, then ascending) so the "Choose a
// <cost> ability" links from class features can target each group by anchor.
const costRank = (cost: any) => (cost === 'signature' ? -1 : Number(cost) || 0);
const costHeading = (cost: any) => (cost === 'signature' ? 'Signature Abilities' : `${cost}-Point Abilities`);
const costGroups = [...new Set(abilities.map((a: any) => a.cost))]
	.sort((a: any, b: any) => costRank(a) - costRank(b))
	.map((cost: any) => ({ cost, abilities: abilities.filter((a: any) => a.cost === cost).sort((x: any, y: any) => (x.minLevel ?? 0) - (y.minLevel ?? 0)) }));
const desc = (c.description || '').replace(/[#*_`>]/g, '').slice(0, 150);
---
<BaseLayout title={c.name} description={desc}>
	<p class="breadcrumb"><a href={href('/')}>Home</a> › <a href={href('/classes')}>Classes</a> › {c.name}</p>
	<h1>{c.name}</h1>
	{c._source && c._source !== 'Core' && <p class="source-tag">{c._source}</p>}

	{primary && <p class="kv"><strong>Primary Characteristics</strong> {primary}</p>}
	{c.description && <div class="md" set:html={renderMarkdown(c.description)} />}

	<h2>Class Features</h2>
	{subclasses.length > 0 && (
		<p class="page-lead">Pick a {subTypeLabel.toLowerCase()} at each level below to compare builds — selections are independent per level.</p>
	)}

	{fbl.map((lvl: any) => {
		const common = lvl.features ?? [];
		const subBlocks = subclasses
			.map((s: any) => ({ s, feats: subFeaturesAt(s, lvl.level) }))
			.filter((b: any) => b.feats.length > 0);
		return (common.length > 0 || subBlocks.length > 0) && (
			<div class="level-block">
				<h3>Level {lvl.level}</h3>
				<FeatureList features={common} />
				{subBlocks.length > 0 && (
					<div class="subclass-section">
						<div class="subclass-tabs" role="tablist" aria-label={`${subTypeLabel} at level ${lvl.level}`}>
							<span class="subclass-tabs-label">{subTypeLabel}:</span>
							{subBlocks.map((b: any, i: number) => (
								<button type="button" class:list={['subclass-tab', { active: i === 0 }]} data-subclass={entrySlug(b.s)} aria-pressed={i === 0 ? 'true' : 'false'}>
									{b.s.name}
								</button>
							))}
						</div>
						{subBlocks.map((b: any, i: number) => (
							<div class:list={['subclass-inline', { active: i === 0 }]} data-subclass={entrySlug(b.s)}>
								<p class="subclass-inline-label"><a href={`#${entrySlug(b.s)}`}>{b.s.name} — full details ↓</a></p>
								<FeatureList features={b.feats} />
							</div>
						))}
					</div>
				)}
			</div>
		);
	})}

	{abilities.length > 0 && (
		<>
			<h2 id="class-abilities">Class Abilities</h2>
			{costGroups.map(g => (
				<section>
					<h3 id={abilityCostAnchor(g.cost)}>{costHeading(g.cost)}</h3>
					{g.abilities.map((a: any) => <Ability ability={a} />)}
				</section>
			))}
		</>
	)}

	{(c.subclasses ?? []).length > 0 && (
		<>
			<h2 id="subclasses">{subTypeLabel} — Full Details</h2>
			{c.subclasses.map((s: any) => (
				<section>
					<h3 id={entrySlug(s)}>{s.name}</h3>
					{s.description && <div class="md" set:html={renderMarkdown(s.description)} />}
					{(s.featuresByLevel ?? []).map((lvl: any) => (
						(lvl.features ?? []).length > 0 && (
							<div class="level-block">
								<h3>Level {lvl.level}</h3>
								<FeatureList features={lvl.features} />
							</div>
						)
					))}
					{(s.abilities ?? []).length > 0 && s.abilities.map((a: any) => <Ability ability={a} />)}
				</section>
			))}
		</>
	)}

	<script>
		// Per-level subclass selector: each level's tabs toggle only that level's
		// inline blocks, so you can mix subclasses across levels to compare builds.
		document.querySelectorAll<HTMLElement>('.subclass-section').forEach(section => {
			const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('.subclass-tab'));
			const blocks = Array.from(section.querySelectorAll<HTMLElement>('.subclass-inline'));
			tabs.forEach(tab =>
				tab.addEventListener('click', () => {
					const key = tab.dataset.subclass;
					tabs.forEach(t => {
						const on = t.dataset.subclass === key;
						t.classList.toggle('active', on);
						t.setAttribute('aria-pressed', String(on));
					});
					blocks.forEach(b => b.classList.toggle('active', b.dataset.subclass === key));
				})
			);
		});
	</script>
</BaseLayout>
