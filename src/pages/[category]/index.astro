---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CATEGORIES, byKey } from '~/lib/categories';
import { all, allSorted } from '~/lib/data';
import { entrySlug } from '~/lib/data';
import { href, slugify } from '~/lib/url';
import { renderMarkdown } from '~/lib/markdown';

export function getStaticPaths() {
	return CATEGORIES.map(c => ({ params: { category: c.key }, props: { category: c.key } }));
}

const { category } = Astro.props;
const cat = byKey(category)!;
// Most pages list alphabetically; the Monster Basics glossary keeps its authored
// (chapter) order instead.
const entries = category === 'monster-basics' ? all(category) : allSorted(category);

// group helper for the simple reference lists
const groupBy = (items: any[], key: string) => {
	const map = new Map<string, any[]>();
	for (const it of items) {
		const g = it[key] || 'Other';
		if (!map.has(g)) map.set(g, []);
		map.get(g)!.push(it);
	}
	return [...map.entries()].sort((a, b) => a[0].localeCompare(b[0]));
};
---
<BaseLayout title={cat.title} description={cat.blurb}>
	<p class="breadcrumb"><a href={href('/')}>Home</a> › {cat.title}</p>
	<h1>{cat.title}</h1>
	<p class="page-lead">{cat.blurb}</p>

	{/* Inline-content glossaries: full content with an anchor TOC */}
	{(category === 'rules' || category === 'conditions' || category === 'monster-basics') && (
		<>
			<div class="filter-bar" id="filter-bar">
				{entries.map(e => <a class="pill" href={`#${slugify(e.name)}`}>{e.name}</a>)}
			</div>
			{entries.map(e => (
				<section>
					<h2 id={slugify(e.name)}>{e.name}</h2>
					<div class="md" set:html={renderMarkdown(e.content)} />
				</section>
			))}

			{/* Mobile only: the filter bar isn't sticky on small screens (it would
			    swallow the viewport), so offer a quick jump back to it at the top. */}
			<a href="#filter-bar" class="to-top" aria-label="Back to top / filters" data-pagefind-ignore>↑</a>
			<script is:inline>
				(() => {
					const btn = document.querySelector('.to-top');
					if (!btn) return;
					const onScroll = () => btn.classList.toggle('show', window.scrollY > 600);
					window.addEventListener('scroll', onScroll, { passive: true });
					onScroll();
				})();
			</script>
		</>
	)}

	{/* Skills: grouped by list */}
	{category === 'skills' && groupBy(entries, 'list').map(([group, items]) => (
		<section>
			<h2>{group}</h2>
			<dl>
				{items.map((s: any) => <><dt><strong>{s.name}</strong></dt><dd>{s.description}</dd></>)}
			</dl>
		</section>
	))}

	{/* Languages: grouped by type */}
	{category === 'languages' && groupBy(entries, 'type').map(([group, items]) => (
		<section>
			<h2>{group}</h2>
			<dl>
				{items.map((l: any) => <><dt><strong>{l.name}</strong></dt><dd>{l.description}{l.related?.length ? <span class="source-tag"> Related: {l.related.join(', ')}</span> : null}</dd></>)}
			</dl>
		</section>
	))}

	{/* Perks: grouped by their skill list, linking to detail pages */}
	{category === 'perks' && groupBy(entries, 'list').map(([group, items]) => (
		<section>
			<h2>{group}</h2>
			<ul class="entry-list">
				{items.map((p: any) => (
					<li>
						<a href={href(`/${category}/${entrySlug(p)}`)}>{p.name}</a>
						{p._source && p._source !== 'Core' && <span class="source-tag"> {p._source}</span>}
					</li>
				))}
			</ul>
		</section>
	))}

	{/* All other (list) categories: alphabetical links to detail pages */}
	{cat.style === 'list' && category !== 'perks' && (
		<ul class="entry-list">
			{entries.map(e => (
				<li>
					<a href={href(`/${category}/${entrySlug(e)}`)}>{e.name}</a>
					{e._source && e._source !== 'Core' && <span class="source-tag"> {e._source}</span>}
				</li>
			))}
		</ul>
	)}
</BaseLayout>
