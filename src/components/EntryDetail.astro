---
import { renderMarkdown } from '~/lib/markdown';
import { href } from '~/lib/url';
import { byKey } from '~/lib/categories';
import FeatureList from './FeatureList.astro';
import Feature from './Feature.astro';
import Ability from './Ability.astro';
import Crafting from './Crafting.astro';

const { entry: e, category } = Astro.props;
const cat = byKey(category);
// Only show level blocks that actually carry features, so consumables whose
// featuresByLevel is a set of empty levels (e.g. Healing Potion) aren't shown
// as leveled items.
const fbl = (e.featuresByLevel ?? []).filter((lvl: any) => (lvl.features ?? []).length > 0);
const sign = (n: number) => (n >= 0 ? `+${n}` : `${n}`);

// A terrain/upgrade section's `content` is an array of feature nodes (Text,
// Ability, …) rather than a markdown string; render those through Feature.
const sectionNodes = (s: any): any[] => (Array.isArray(s?.content) ? s.content : []);

// Negotiation outcomes are keyed by Interest level (0–5). The source data leaves
// them blank, falling back to forgesteel's standard ladder.
const OUTCOME_DEFAULTS: Record<number, string> = {
	5: 'Yes, and…',
	4: 'Yes',
	3: 'Yes, but…',
	2: 'No, but…',
	1: 'No',
	0: 'No, and…'
};
---
<p class="breadcrumb">
	<a href={href('/')}>Home</a> › <a href={href(`/${category}`)}>{cat?.title}</a> › {e.name}
</p>

<h1>{e.name}</h1>
{e._source && e._source !== 'Core' && <p class="source-tag">{e._source}</p>}

{/* items: keywords + type */}
{category === 'items' && (
	<div class="pills">
		{e.type && <span class="pill pill-usage">{e.type}</span>}
		{(e.keywords ?? []).map((k: string) => <span class="pill">{k}</span>)}
	</div>
)}

{category === 'imbuements' && (
	<p class="kv">{e.type && <span><strong>Type</strong> {e.type}&nbsp;&nbsp;</span>}{e.level != null && <span><strong>Level</strong> {e.level}</span>}</p>
)}

{/* titles: echelon + how it's earned */}
{category === 'titles' && (e.echelon != null || e.prerequisites) && (
	<p class="kv">
		{e.echelon != null && <span><strong>Echelon</strong> {e.echelon}&nbsp;&nbsp;</span>}
		{e.prerequisites && <span><strong>Prerequisite</strong> {e.prerequisites}</span>}
	</p>
)}

{/* ancestries: trait point budget */}
{category === 'ancestries' && e.ancestryPoints != null && (
	<p class="kv"><strong>Ancestry Points</strong> {e.ancestryPoints}</p>
)}

{e.description && <div class="md" set:html={renderMarkdown(e.description)} />}

{/* kits: equipment + combat stat bonuses */}
{category === 'kits' && (
	<div class="sb-stats">
		{e.armor?.length > 0 && <span><strong>Armor</strong> {e.armor.join(', ')}</span>}
		{e.weapon?.length > 0 && <span><strong>Weapon</strong> {e.weapon.join(', ')}</span>}
		{e.stamina > 0 && <span><strong>Stamina</strong> +{e.stamina}</span>}
		{e.speed > 0 && <span><strong>Speed</strong> +{e.speed}</span>}
		{e.stability > 0 && <span><strong>Stability</strong> +{e.stability}</span>}
		{e.meleeDamage && <span><strong>Melee Damage</strong> +{e.meleeDamage.tier1} / +{e.meleeDamage.tier2} / +{e.meleeDamage.tier3}</span>}
		{e.rangedDamage && <span><strong>Ranged Damage</strong> +{e.rangedDamage.tier1} / +{e.rangedDamage.tier2} / +{e.rangedDamage.tier3}</span>}
		{e.meleeDistance > 0 && <span><strong>Melee Distance</strong> +{e.meleeDistance}</span>}
		{e.rangedDistance > 0 && <span><strong>Ranged Distance</strong> +{e.rangedDistance}</span>}
		{e.disengage > 0 && <span><strong>Disengage</strong> +{e.disengage}</span>}
	</div>
)}

{/* imbuements: the mechanical feature (ability, modifier, …) beyond the flavour */}
{category === 'imbuements' && e.feature && e.feature.type !== 'Text' && <Feature feature={e.feature} />}
{category === 'imbuements' && e.crafting && <Crafting crafting={e.crafting} />}

{/* perks: the granted ability, if any */}
{category === 'perks' && e.type === 'Ability' && e.data?.ability && <Ability ability={e.data.ability} />}

{/* cultures: the meaningful content is the environment/organization/upbringing
    aspects (each with its own description + skill grant) plus the language. */}
{category === 'cultures' && (
	<>
		{e.type && <p class="kv"><strong>Type</strong> {e.type}</p>}
		{[e.environment, e.organization, e.upbringing, e.language].filter(Boolean).map((a: any) => <Feature feature={a} />)}
	</>
)}

{/* abilities category: the entry itself is an ability */}
{category === 'abilities' && <Ability ability={e} />}

{/* items: effect + crafting + per-level features */}
{category === 'items' && e.effect && <div class="md" set:html={renderMarkdown(e.effect)} />}
{category === 'items' && e.crafting && <Crafting crafting={e.crafting} />}

{/* terrain stat row + sections + upgrades */}
{category === 'terrain' && (
	<>
		<div class="sb-stats">
			{e.level != null && <span><strong>Level</strong> {e.level}</span>}
			{e.role?.type && <span><strong>Role</strong> {e.role.type}{e.role.terrainType ? ` (${e.role.terrainType})` : ''}</span>}
			{e.encounterValue != null && <span><strong>EV</strong> {e.encounterValue}</span>}
			{e.stamina && <span><strong>Stamina</strong> {e.stamina.base}{e.stamina.perSquare ? ` (+${e.stamina.perSquare}/sq)` : ''}</span>}
			{e.area && <span><strong>Area</strong> {e.area}</span>}
			{e.size && <span><strong>Size</strong> {typeof e.size === 'object' ? `${e.size.value ?? ''}${e.size.mod ?? ''}` : e.size}</span>}
		</div>
		{(e.sections ?? []).map((s: any) => sectionNodes(s).map((c: any) => <Feature feature={c} />))}
		{(e.upgrades ?? []).length > 0 && (
			<>
				<h3>Upgrades</h3>
				{e.upgrades.map((u: any) => (
					<div class="feature">
						<p class="feature-name">{u.label}{u.cost != null ? ` (${u.cost})` : ''}</p>
						{u.text && <div class="md" set:html={renderMarkdown(u.text)} />}
						{(u.sections ?? []).map((s: any) => sectionNodes(s).map((c: any) => <Feature feature={c} />))}
					</div>
				))}
			</>
		)}
	</>
)}

{/* negotiations */}
{category === 'negotiations' && (
	<>
		<div class="sb-stats">
			{e.attitude && <span><strong>Attitude</strong> {e.attitude}</span>}
			{e.impression != null && <span><strong>Impression</strong> {e.impression}</span>}
			{e.interest != null && <span><strong>Interest</strong> {e.interest}</span>}
			{e.patience != null && <span><strong>Patience</strong> {e.patience}</span>}
		</div>
		{(e.motivations ?? []).length > 0 && <h3>Motivations</h3>}
		{(e.motivations ?? []).map((m: any) => <div class="feature"><p class="feature-name">{m.trait}</p><div class="md" set:html={renderMarkdown(m.description)} /></div>)}
		{(e.pitfalls ?? []).length > 0 && <h3>Pitfalls</h3>}
		{(e.pitfalls ?? []).map((m: any) => <div class="feature"><p class="feature-name">{m.trait}</p><div class="md" set:html={renderMarkdown(m.description)} /></div>)}
		<h3>Outcomes</h3>
		<p class="page-lead">The result of the negotiation based on the NPC's final Interest.</p>
		<table class="outcomes">
			<tbody>
				{[5, 4, 3, 2, 1, 0].map(i => (
					<tr>
						<td class="tier">{i}</td>
						<td set:html={renderMarkdown(e.outcomes?.[i] || OUTCOME_DEFAULTS[i])} />
					</tr>
				))}
			</tbody>
		</table>
	</>
)}

{/* montages */}
{category === 'montages' && (
	<>
		{e.difficulty && <p class="kv"><strong>Difficulty</strong> {e.difficulty}</p>}
		{e.scene && <div class="md" set:html={renderMarkdown(e.scene)} />}
		{(e.sections ?? []).map((s: any) => (
			<div class="feature">
				{s.name && <p class="feature-name">{s.name}</p>}
				{s.description && <div class="md" set:html={renderMarkdown(s.description)} />}
			</div>
		))}
		{e.outcomes && (
			<>
				<h3>Outcomes</h3>
				{e.outcomes.totalSuccess && <p><strong>Total success:</strong> <span set:html={renderMarkdown(e.outcomes.totalSuccess)} /></p>}
				{e.outcomes.partialSuccess && <p><strong>Partial success:</strong> <span set:html={renderMarkdown(e.outcomes.partialSuccess)} /></p>}
				{e.outcomes.totalFailure && <p><strong>Total failure:</strong> <span set:html={renderMarkdown(e.outcomes.totalFailure)} /></p>}
			</>
		)}
	</>
)}

{/* projects */}
{category === 'projects' && (
	<div class="sb-stats">
		{e.goal != null && <span><strong>Goal</strong> {e.goal}</span>}
		{(e.characteristic ?? []).length > 0 && <span><strong>Roll</strong> {e.characteristic.join(' or ')}</span>}
		{e.source && <span><strong>Source</strong> {e.source}</span>}
		{e.itemPrerequisites && <span><strong>Prerequisite</strong> {e.itemPrerequisites}</span>}
	</div>
)}

{/* careers: inciting incidents */}
{category === 'careers' && (e.incitingIncidents?.options ?? []).length > 0 && (
	<>
		<h3>Inciting Incidents</h3>
		<ol>
			{e.incitingIncidents.options.map((o: any) => (
				<li><strong>{o.name}</strong>{o.description ? <> — <span set:html={renderMarkdown(o.description)} /></> : null}</li>
			))}
		</ol>
	</>
)}

{/* domains: resource gains */}
{category === 'domains' && (e.resourceGains ?? []).length > 0 && (
	<>
		<h3>Resource Gains</h3>
		<ul class="resource-gains">{e.resourceGains.map((g: any) => <li><strong>{/^\d/.test(String(g.value)) ? '+' : ''}{g.value}{g.resource ? ` ${g.resource}` : ''}</strong> — {g.trigger}</li>)}</ul>
	</>
)}

{/* shared structured blocks */}
{(e.defaultFeatures ?? []).length > 0 && <FeatureList features={e.defaultFeatures} />}
{category !== 'abilities' && (e.features ?? []).length > 0 && <FeatureList features={e.features} />}

{fbl.length > 0 && fbl.map((lvl: any) => (
	<div class="level-block">
		<h3>Level {lvl.level}</h3>
		<FeatureList features={lvl.features ?? []} />
	</div>
))}

{(e.abilities ?? []).length > 0 && (
	<>
		<h3>Abilities</h3>
		{e.abilities.map((a: any) => <Ability ability={a} />)}
	</>
)}
