---
import { renderMarkdown, renderInline } from '~/lib/markdown';
import { href, abilityCostAnchor, abilityCostLabel } from '~/lib/url';
import { all, entrySlug } from '~/lib/data';
import Ability from './Ability.astro';
import StatBlock from './StatBlock.astro';

const { feature } = Astro.props;
const f = feature ?? {};
const t: string = f.type ?? '';
const d: any = f.data ?? {};
const Self = Astro.self;
const plural = (n: number) => (n > 1 ? 's' : '');
const sign = (n: number) => (n >= 0 ? `+${n}` : `${n}`);

// Power-roll rendering (shared shape with abilities) for monster malice sections.
const tierLabels = ['11 or lower', '12–16', '17+'];
const charAbbrev: Record<string, string> = { Might: 'M', Agility: 'A', Reason: 'R', Intuition: 'I', Presence: 'P' };
const rollHead = (chars: string[] = []) =>
	chars.length ? `Power Roll + ${chars.map(c => charAbbrev[c] ?? c).join(' or ')}` : 'Power Roll';

// Mirror forgesteel's FormatLogic.getModifier for damage immunities/weaknesses,
// so e.g. a revenant's cold immunity reads "+1 per level" rather than just "1".
function formatModifier(m: any): string {
	const parts: string[] = [];
	if (m.value && m.valuePerLevel && m.value === m.valuePerLevel) {
		parts.push(`${sign(m.value)} per level`);
	} else {
		if (m.value) parts.push(sign(m.value));
		if (m.valuePerLevel) parts.push(`${sign(m.valuePerLevel)} per level after 1st`);
	}
	if (m.valuePerEchelon) parts.push(`${sign(m.valuePerEchelon)} per echelon`);
	const chars: string[] = m.valueCharacteristics ?? [];
	if (chars.length > 0) {
		const ch = chars.length === 5 ? 'highest characteristic' : chars.join(' or ');
		parts.push(m.valueCharacteristicMultiplier === 1 ? `+${ch}` : `+${ch} × ${m.valueCharacteristicMultiplier}`);
	}
	return parts.join(' ') || '+0';
}

// Cross-reference summaries: a choice that should link somewhere useful.
// (Class Ability links to the same-page cost group on a class detail page.)
type LinkSummary = { pre: string; linkText: string; to: string; post?: string };
function linkSummary(): LinkSummary | null {
	const count = d.count ?? 1;
	switch (t) {
		case 'Kit': {
			const types = (d.types ?? []).filter((x: string) => x && x.trim());
			return { pre: `Choose ${count} `, linkText: `kit${plural(count)}`, to: href('/kits'), post: types.length ? ` (${types.join(', ')})` : '' };
		}
		case 'Perk': {
			const lists = (d.lists ?? []).filter(Boolean);
			return { pre: `Choose ${count} `, linkText: `perk${plural(count)}`, to: href('/perks'), post: lists.length ? ` (${lists.join(', ')})` : '' };
		}
		case 'Class Ability':
			return {
				pre: `Choose ${count} `,
				linkText: `${abilityCostLabel(d.cost)} ability${count > 1 ? 'ies' : ''}`,
				to: `#${abilityCostAnchor(d.cost)}`,
				post: d.minLevel ? ` (level ${d.minLevel}+)` : ''
			};
		case 'Domain':
			return { pre: `Choose ${count} `, linkText: `domain${plural(count)}`, to: href('/domains'), post: d.characteristic ? ` (${d.characteristic})` : '' };
		default:
			return null;
	}
}
const linkSum = linkSummary();

// Synthesise a one-line summary for structured features that carry little/no prose.
function summary(): string | null {
	switch (t) {
		case 'Bonus':
			return d.field ? `+${d.value ?? 0} ${d.field}` : null;
		case 'Characteristic Bonus':
			return `+${d.value ?? 0} ${d.characteristic ?? ''}`.trim();
		case 'Speed':
			return d.speed != null ? `Speed ${d.speed}` : null;
		case 'Size':
			return d.size ? `Size ${d.size.value ?? ''}${d.size.mod ?? ''}` : null;
		case 'Save Threshold':
			return d.value != null ? `Save threshold ${d.value}` : null;
		case 'Language':
			return d.language ? `Language: ${d.language}` : null;
		case 'Condition Immunity':
			return d.conditions?.length ? `Immune to: ${d.conditions.join(', ')}` : null;
		case 'Movement Mode':
			return d.mode ? `Movement mode: ${d.mode}` : null;
		case 'Proficiency': {
			const parts = [];
			if (d.weapons?.length) parts.push(`Weapons: ${d.weapons.join(', ')}`);
			if (d.armor?.length) parts.push(`Armor: ${d.armor.join(', ')}`);
			return parts.join(' · ') || null;
		}
		case 'Skill Choice': {
			const from = d.options?.length ? ` from ${d.options.join(', ')}` : d.listOptions?.length ? ` from the ${d.listOptions.join(', ')} skill group${d.listOptions.length > 1 ? 's' : ''}` : '';
			return `Choose ${d.count ?? 1} skill${(d.count ?? 1) > 1 ? 's' : ''}${from}`;
		}
		case 'Language Choice':
			return `Choose ${d.count ?? 1} language${(d.count ?? 1) > 1 ? 's' : ''}${d.options?.length ? ` from ${d.options.join(', ')}` : ''}`;
		case 'Damage Modifier':
			return d.modifiers?.length
				? d.modifiers.map((m: any) => `${m.damageType ?? 'All'} ${m.type ?? ''} ${formatModifier(m)}`.replace(/\s+/g, ' ').trim()).join(' · ')
				: null;
		case 'Ability Distance': {
			const kw = (d.keywords ?? []).join(', ');
			return `${kw ? `${kw}: ` : ''}${formatModifier(d)} distance`;
		}
		case 'Ability Damage': {
			const kw = (d.keywords ?? []).join(', ');
			// damageType is the literal "Damage" when untyped — don't print it twice.
			const dt = d.damageType && d.damageType !== 'Damage' ? ` ${d.damageType}` : '';
			return `${kw ? `${kw}: ` : ''}${formatModifier(d)}${dt} damage`;
		}
		case 'Heroic Resource Gain':
			return d.value != null ? `+${d.value}${d.trigger ? ` — ${d.trigger}` : ''}` : null;
		case 'Switch Value':
			return d.switch ? `${d.switch}: ${d.value}` : null;
		case 'Ancestry Feature Choice': {
			const former = d.source?.former && !d.source?.current;
			return `Choose a ${d.value ?? 1}-point ancestry feature${former ? ' from a former life' : ''}`;
		}
		case 'Follower': {
			const fl = d.follower ?? {};
			const chars = (fl.characteristics ?? []).map((c: any) => `${(c.characteristic || '').slice(0, 3)} ${sign(c.value)}`).join(', ');
			return `Follower${fl.type ? `: ${fl.type}` : ''}${chars ? ` — ${chars}` : ''}`;
		}
		case 'Retainer':
			return 'You gain a retainer who levels up alongside you.';
		default:
			return null;
	}
}
const summaryLine = summary();
// When a feature carries a synthesised one-line mechanic, its `description` is
// flavour text — show the mechanic prominently and the flavour italic/dim (like
// abilities). Plain features without a mechanic keep their description as the
// main body text.
const hasMechanic = !!(linkSum || summaryLine);
const children: any[] = t === 'Multiple Features' ? d.features ?? [] : [];
const choiceOptions: any[] = t === 'Choice' ? d.options ?? [] : [];
const resourceGains: any[] = t === 'Heroic Resource' ? d.gains ?? [] : [];
// Summoner minions (Summon) and Beastheart companions (Summon Choice) each carry
// a `monster` stat block we want to render in full.
const summons: any[] = t === 'Summon' ? d.summons ?? [] : t === 'Summon Choice' ? d.options ?? [] : [];

// Monster malice: cost + sections (markdown strings interleaved with power rolls).
const maliceCost = t === 'Malice' ? d.cost : null;
const maliceSections: any[] = t === 'Malice' ? d.sections ?? [] : [];
// Elementalist-style switches: each option grants a sub-feature, keyed by value.
const switchOptions: any[] = t === 'Switch Options' ? d.options ?? [] : [];
// Features that wrap another feature.
const controllerFeature: any = t === 'For Controller' ? d.feature : null;
const toggleFeature: any = t === 'Toggle' ? d.featureChecked : null;
// Summoner fixtures: a terrain-like stat block embedded in a feature. Keep the
// per-level grouping so upgrades that arrive at higher levels are labelled (the
// baseline level-1 features render unlabelled, later levels show "Level N").
const fixture: any = t === 'Fixture' ? d.fixture : null;
const fixtureLevels: { level: number; features: any[] }[] = (fixture?.featuresByLevel ?? [])
	.map((lvl: any) => ({ level: lvl.level, features: lvl.features ?? [] }))
	.filter((lvl: any) => lvl.features.length > 0);

// Types whose name is generic boilerplate fully replaced by the summary/sub-render.
const HIDE_NAME = new Set(['Ability Distance', 'Ability Damage', 'For Controller']);
const showName = f.name && !HIDE_NAME.has(t);

// Choice rendering: a header that names the pick, and per-option point costs when
// they're meaningful (ancestry trait point-buy, or options with varying values).
const choiceCount = t === 'Choice' ? d.count : undefined;
const choiceHeader =
	choiceCount === 'ancestry'
		? 'Choose traits using your ancestry points:'
		: typeof choiceCount === 'number' && choiceCount > 1
			? `Choose ${choiceCount}:`
			: 'Choose one:';
const showChoiceCosts = t === 'Choice' && (choiceCount === 'ancestry' || choiceOptions.some((o: any) => (o.value ?? 1) !== 1));

// Conduit domains: render a domain selector inline at "Domain" / "Domain Feature"
// slots, so you can pick a domain and see what it grants right in the progression
// (mirrors the per-level subclass selector on other classes).
function domainVariants(): { key: string; name: string; link: string; gains: any[]; defaults: any[]; feats: any[] }[] | null {
	if (t !== 'Domain' && t !== 'Domain Feature') return null;
	const items = all('domains')
		.slice()
		.sort((a: any, b: any) => a.name.localeCompare(b.name))
		.map((dom: any) => {
			const base = { key: entrySlug(dom), name: dom.name, link: href(`/domains/${entrySlug(dom)}`) };
			if (t === 'Domain Feature') {
				const lvl = d.level ?? 1;
				const feats = (dom.featuresByLevel ?? []).find((l: any) => l.level === lvl)?.features ?? [];
				return { ...base, gains: [], defaults: [], feats };
			}
			// 'Domain' — the always-on parts gained when you take a domain
			return { ...base, gains: dom.resourceGains ?? [], defaults: dom.defaultFeatures ?? [], feats: [] };
		})
		.filter((b: any) => b.feats.length > 0 || b.gains.length > 0 || b.defaults.length > 0);
	return items.length ? items : null;
}
const domainBlocks = domainVariants();
---
{t === 'Ability' || t === 'Malice Ability' ? (
	<div class="feature">
		<Ability ability={d.ability} />
	</div>
) : (
	<div class="feature">
		{showName && <p class="feature-name">{f.name}</p>}
		{maliceCost != null && <p class="feature-summary">{maliceCost} Malice{d.repeatable ? ' · repeatable' : ''}</p>}
		{linkSum && <p class="feature-summary">{linkSum.pre}<a href={linkSum.to}>{linkSum.linkText}</a>{linkSum.post}</p>}
		{!linkSum && summaryLine && <p class="feature-summary">{summaryLine}</p>}
		{f.description && (
			hasMechanic
				? <div class="feature-flavor md" set:html={renderMarkdown(f.description)} />
				: <div class="md" set:html={renderMarkdown(f.description)} />
		)}

		{domainBlocks && (
			<div class="subclass-section">
				<div class="subclass-tabs" role="tablist" aria-label="Choose a domain">
					<span class="subclass-tabs-label">Domain:</span>
					{domainBlocks.map((b, i) => (
						<button type="button" class:list={['subclass-tab', { active: i === 0 }]} data-subclass={b.key} aria-pressed={i === 0 ? 'true' : 'false'}>{b.name}</button>
					))}
				</div>
				{domainBlocks.map((b, i) => (
					<div class:list={['subclass-inline', { active: i === 0 }]} data-subclass={b.key}>
						<p class="subclass-inline-label"><a href={b.link}>{b.name} — full details →</a></p>
						{b.gains.length > 0 && <ul class="resource-gains">{b.gains.map((g: any) => <li><strong>{g.value} {g.resource}</strong> — {g.trigger}</li>)}</ul>}
						{b.defaults.map((fe: any) => <Self feature={fe} />)}
						{b.feats.map((fe: any) => <Self feature={fe} />)}
					</div>
				))}
			</div>
		)}

		{maliceSections.map((s: any) => (
			typeof s === 'string'
				? <div class="md" set:html={renderMarkdown(s)} />
				: s && s.tier1 !== undefined
					? (
						<table class="power-roll">
							<caption>{rollHead(s.characteristic)}</caption>
							<tbody>
								<tr><td class="tier">{tierLabels[0]}</td><td set:html={renderInline(s.tier1)} /></tr>
								<tr><td class="tier">{tierLabels[1]}</td><td set:html={renderInline(s.tier2)} /></tr>
								<tr><td class="tier">{tierLabels[2]}</td><td set:html={renderInline(s.tier3)} /></tr>
							</tbody>
						</table>
					)
					: null
		))}

		{controllerFeature && (
			<div class="feature-children">
				<p class="feature-note">Applies to the controller:</p>
				<Self feature={controllerFeature} />
			</div>
		)}

		{toggleFeature && (
			<div class="feature-children">
				{d.condition && <p class="feature-note">While {d.condition.toLowerCase()}:</p>}
				<Self feature={toggleFeature} />
			</div>
		)}

		{switchOptions.length > 0 && (
			<div class="feature-children">
				{switchOptions.map((o: any) => (
					<div class="feature">
						<p class="feature-note">{o.value}</p>
						<Self feature={o.feature} />
					</div>
				))}
			</div>
		)}

		{fixture && (
			<div class="summon">
				{fixture.description && <div class="md" set:html={renderMarkdown(fixture.description)} />}
				<div class="sb-stats">
					{fixture.role?.type && <span><strong>Role</strong> {fixture.role.type}{fixture.role.terrainType ? ` (${fixture.role.terrainType})` : ''}</span>}
					{fixture.baseStamina != null && <span><strong>Stamina</strong> {fixture.baseStamina}</span>}
					{fixture.size && <span><strong>Size</strong> {fixture.size.value ?? ''}{fixture.size.mod ?? ''}</span>}
				</div>
				{fixtureLevels.map((lvl, i) => (
					<>
						{(i > 0 || lvl.level > 1) && <p class="feature-note">Level {lvl.level}</p>}
						{lvl.features.map((fe: any) => <Self feature={fe} />)}
					</>
				))}
			</div>
		)}

		{resourceGains.length > 0 && (
			<ul class="resource-gains">
				{resourceGains.map((g: any) => <li><strong>{/^\d/.test(String(g.value)) ? '+' : ''}{g.value}{g.resource ? ` ${g.resource}` : ''}</strong> — {g.trigger}</li>)}
			</ul>
		)}

		{choiceOptions.length > 0 && (
			<div class="choice-group">
				<p class="feature-note">{choiceHeader}</p>
				{choiceOptions.map((o: any) => (
					<div class="choice-option">
						{showChoiceCosts && o.value != null && <span class="choice-cost">{o.value} pt{o.value === 1 ? '' : 's'}</span>}
						<div class="choice-option-body"><Self feature={o.feature} /></div>
					</div>
				))}
			</div>
		)}

		{children.length > 0 && (
			<div class="feature-children">
				{children.map((c: any) => <Self feature={c} />)}
			</div>
		)}

		{summons.length > 0 && (
			<div class="feature-children">
				{t === 'Summon Choice' && d.count > 1 && <p class="feature-note">Choose {d.count}:</p>}
				{summons.map((s: any) => {
					const info = s.info;
					// Summoner minions carry a summoning cost (in essence) and the number
					// of minions a single payment buys; signature minions are free.
					const costLine = info && info.cost > 0
						? `${info.cost} essence ${info.count === 1 ? 'per minion summoned' : `for ${info.count} minions`}`
						: null;
					// Minions/champions also gain upgrades at levels 3/6/10 — surface them
					// grouped by level so the progression is visible (mirrors fixtures).
					const upgrades = info
						? ([[3, info.level3], [6, info.level6], [10, info.level10]] as [number, any[]][])
							.map(([level, feats]) => ({ level, features: feats ?? [] }))
							.filter(u => u.features.length > 0)
						: [];
					return (
						<div class="summon">
							<div class="summon-tags">
								{info?.isSignature && <span class="summon-tag">Signature</span>}
								{costLine && <span class="summon-cost">{costLine}</span>}
							</div>
							{s.description && <div class="md" set:html={renderMarkdown(s.description)} />}
							{s.monster && <StatBlock monster={s.monster} />}
							{upgrades.map(u => (
								<>
									<p class="feature-note">Level {u.level}</p>
									{u.features.map((fe: any) => <Self feature={fe} />)}
								</>
							))}
						</div>
					);
				})}
			</div>
		)}
	</div>
)}
